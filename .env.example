# ---------------------------------------------------------------------------
# Template for the untracked .env file.
#
#   cp .env.example .env       then fill in the one key you want to use.
#
# .env is listed in .gitignore, so real keys never reach the repository.
# Every value here can equally be supplied as a normal environment variable,
# which is what CI should do.
# ---------------------------------------------------------------------------

# Which classifier the bonus AI tests use.
#   rule   - local keyword classifier, needs no key and no network (default)
#   gemini - Google Gemini
#   groq   - Groq, serving open-source models such as Llama
#   openai - OpenAI
AI_PROVIDER=rule

# Fill in only the key matching AI_PROVIDER above.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: pin a specific model. Leave blank to use the provider's default
# (gemini-2.0-flash, llama-3.3-70b-versatile, gpt-4o-mini respectively).
AI_MODEL=

# Optional run overrides, handy for a one-off local run:
# BROWSER=chrome
# HEADLESS=false
